{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Channely",
  "version": "0.2.0",
  "identifier": "com.channely.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build:frontend"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Channely",
        "width": 480,
        "height": 320,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Channely — AI Text Proofreading"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "category": "public.app-category.productivity",
    "shortDescription": "AI-powered text proofreading for macOS",
    "longDescription": "Channely is a system-wide AI text proofreading app. Select text anywhere, press Cmd+Shift+K, and get instant AI-powered corrections with a beautiful floating overlay showing word-level diffs.",
    "copyright": "© 2026 Channely",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDQzM3QzUwMzQ3MjQ0NTQKUldSVVJISTBVSHpEZkVjQ0w2a0piNGtlRXhpN2hmR0lwSXcvZmZnRWtSR2ViVUkwRXZlQm9Ya20K",
      "endpoints": [
        "https://github.com/user/channely/releases/latest/download/latest.json"
      ]
    }
  }
}
